{
  "name": "Booking Agent",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "booking-agent",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "b42a4830-8c8c-4098-aa0d-46d930c80b49",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        112
      ],
      "webhookId": "e76bef4b-c3cf-4a0c-a9e0-6c5a52475a4b"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "tc1",
              "name": "toolCallId",
              "type": "string",
              "value": "={{ JSON.parse(JSON.stringify($json.body.message.toolCalls[0])).id }}"
            },
            {
              "id": "tc2",
              "name": "date",
              "type": "string",
              "value": "={{ (() => { const f = JSON.parse(JSON.stringify($json.body.message.toolCalls[0].function)); const key = Object.keys(f).find(k => k.startsWith(\"argum\")); return key ? f[key].date : \"\"; })() }}"
            },
            {
              "id": "tc3",
              "name": "name",
              "type": "string",
              "value": "={{ (() => { const f = JSON.parse(JSON.stringify($json.body.message.toolCalls[0].function)); const key = Object.keys(f).find(k => k.startsWith(\"argum\")); return key ? (f[key].name || \"\") : \"\"; })() }}"
            },
            {
              "id": "tc4",
              "name": "phone",
              "type": "string",
              "value": "={{ (() => { const f = JSON.parse(JSON.stringify($json.body.message.toolCalls[0].function)); const key = Object.keys(f).find(k => k.startsWith(\"argum\")); return key ? (f[key].phone || \"\") : \"\"; })() }}"
            }
          ]
        },
        "options": {}
      },
      "id": "aed978f6-d814-424c-b83c-ba05f34dfcfe",
      "name": "Extract Tool Call",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        224,
        112
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ \"Booking request from caller: \" + $json.name + \", phone: \" + $json.phone + \", requested time: \" + $json.date + \". Today is \" + $now.toISO() + \". Interpret the requested date/time into a concrete start and end time, then follow the create-or-update procedure and confirm.\" }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are a booking assistant. First check if the caller already has an existing booking using their phone number. If they do, update it with the new details. If not, create a new booking. Confirm only after the calendar operation succeeds, and tell the caller whether their appointment was newly booked or updated."
        }
      },
      "id": "345d2b51-b4ad-4467-a5f6-c7a172648aba",
      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        576,
        112
      ]
    },
    {
      "parameters": {
        "modelName": "models/gemini-3.8-flash",
        "options": {
          "temperature": 0.2
        }
      },
      "id": "c6466d3d-95d5-4da6-91b3-dc5d81e5a986",
      "name": "Google Gemini Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1.2,
      "position": [
        448,
        336
      ],
      "credentials": {
        "googlePalmApi": {
          "id": null,
          "name": "Gateway credits",
          "__aiGatewayManaged": true
        }
      }
    },
    {
      "parameters": {
        "sessionIdType": "customKey",
        "sessionKey": "={{ $(\"Extract Tool Call\").item.json.toolCallId }}"
      },
      "id": "cadddb50-caea-4fa9-b176-31b0694b4475",
      "name": "Simple Memory",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.4,
      "position": [
        576,
        336
      ]
    },
    {
      "parameters": {
        "operation": "getAll",
        "calendar": {
          "__rl": true,
          "value": "your-calendar-id@group.calendar.google.com",
          "mode": "list",
          "cachedResultName": "Development "
        },
        "limit": 10,
        "timeMin": "={{ $now.toISO() }}",
        "timeMax": "={{ $now.plus({ days: 14 }).toISO() }}",
        "options": {
          "query": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('query', \"The caller's phone number to search for in existing event descriptions\") }}"
        }
      },
      "id": "7a13b8b6-8dc3-4613-96d1-b581afd4fa88",
      "name": "search_events",
      "type": "n8n-nodes-base.googleCalendarTool",
      "typeVersion": 1.3,
      "position": [
        640,
        528
      ],
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "rc0683Tw6yXjFqi3",
          "name": "Google Calendar account"
        }
      }
    },
    {
      "parameters": {
        "calendar": {
          "__rl": true,
          "value": "your-calendar-id@group.calendar.google.com",
          "mode": "list",
          "cachedResultName": "Development "
        },
        "start": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('start', 'Event start time in ISO 8601 format') }}",
        "end": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('end', 'Event end time in ISO 8601 format') }}",
        "additionalFields": {
          "description": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('description', \"Event description. MUST include the caller's phone number so the booking can be found later\") }}",
          "summary": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('summary', \"Event title including the caller's name\") }}"
        }
      },
      "id": "d7f883e0-8910-49b8-8c83-9851236d664f",
      "name": "create_event",
      "type": "n8n-nodes-base.googleCalendarTool",
      "typeVersion": 1.3,
      "position": [
        704,
        336
      ],
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "rc0683Tw6yXjFqi3",
          "name": "Google Calendar account"
        }
      }
    },
    {
      "parameters": {
        "operation": "update",
        "calendar": {
          "__rl": true,
          "value": "your-calendar-id@group.calendar.google.com",
          "mode": "list",
          "cachedResultName": "Development "
        },
        "eventId": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('eventId', 'The id of the existing event returned by search_events') }}",
        "updateFields": {
          "description": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('description', \"Event description. MUST keep including the caller's phone number\") }}",
          "end": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('end', 'New event end time in ISO 8601 format') }}",
          "start": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('start', 'New event start time in ISO 8601 format') }}",
          "summary": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('summary', \"New event title including the caller's name\") }}"
        }
      },
      "id": "ef4c97e7-5a21-4974-a4b9-56a3e94c8ca1",
      "name": "update_event",
