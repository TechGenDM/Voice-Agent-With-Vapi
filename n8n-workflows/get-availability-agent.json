{
  "name": "Get Availability Agent",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "get-availability",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "bd798e34-1f69-425e-87ec-6419c5050eef",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        112
      ],
      "webhookId": "ae846e77-c51e-4660-84e9-6eee5178b3e1"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "tc1",
              "name": "toolCallId",
              "type": "string",
              "value": "={{ JSON.parse(JSON.stringify($json.body.message.toolCalls[0])).id }}"
            },
            {
              "id": "tc2",
              "name": "date",
              "type": "string",
              "value": "={{ (() => { const f = JSON.parse(JSON.stringify($json.body.message.toolCalls[0].function)); const key = Object.keys(f).find(k => k.startsWith(\"argum\")); return key ? f[key].date : \"\"; })() }}"
            }
          ]
        },
        "options": {}
      },
      "id": "f4841a10-3aad-4985-b2ee-07c8ab81b7f4",
      "name": "Extract Tool Call",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        0,
        304
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ \"The caller wants to book: \" + $json.date + \". Today is \" + $now.toISO() + \". Interpret the requested date/time into a concrete time range and check calendar availability for it.\" }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are a scheduling assistant. Given a requested date/time, check Google Calendar for conflicts and determine if the slot is available. Respond only with structured data indicating availability."
        }
      },
      "id": "0c8e9f72-fbf9-4a99-9c31-5b86aa2978c3",
      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        352,
        112
      ]
    },
    {
      "parameters": {
        "modelName": "models/gemini-3.8-flash",
        "options": {
          "temperature": 0.2
        }
      },
      "id": "d7d5416e-0cd5-4eb8-a536-7cf9891fbcce",
      "name": "Google Gemini Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1.2,
      "position": [
        224,
        336
      ],
      "credentials": {
        "googlePalmApi": {
          "id": null,
          "name": "Gateway credits",
          "__aiGatewayManaged": true
        }
      }
    },
    {
      "parameters": {
        "sessionIdType": "customKey",
        "sessionKey": "={{ $(\"Extract Tool Call\").item.json.toolCallId }}"
      },
      "id": "358edebf-45b0-43b6-87c6-c016a147ee3e",
      "name": "Simple Memory",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.4,
      "position": [
        352,
        336
      ]
    },
    {
      "parameters": {
        "resource": "calendar",
        "calendar": {
          "__rl": true,
          "value": "your-calendar-id@group.calendar.google.com",
          "mode": "list",
          "cachedResultName": "Development "
        },
        "timeMin": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('timeMin', 'Start of the interval to check, in ISO 8601 format') }}",
        "timeMax": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('timeMax', 'End of the interval to check, in ISO 8601 format') }}",
        "options": {}
      },
      "id": "951f776a-6470-4955-b6d6-283bc3288786",
      "name": "check_availability",
      "type": "n8n-nodes-base.googleCalendarTool",
      "typeVersion": 1.3,
      "position": [
        480,
        336
      ],
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "rc0683Tw6yXjFqi3",
          "name": "Google Calendar account"
        }
      }
    },
    {
      "parameters": {
        "jsonSchemaExample": "{\n  \"available\": true,\n  \"message\": \"The requested slot is available.\"\n}"
      },
      "id": "66931bb2-ca63-48e7-98b2-32de1e250212",
      "name": "Structured Output Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        608,
        336
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { results: [{ toolCallId: $(\"Extract Tool Call\").item.json.toolCallId, result: $json.output.message }] } }}",
        "options": {}
      },
      "id": "c26e0ee8-666d-4269-8510-4fd2a27e8dba",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
